---
import { Button } from '@/components/ui/button';
import SiteLayout from '../layouts/site-layout.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { getAlternateLocale, getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const alternateLocale = getAlternateLocale(locale);

// Static hosts serve the default-locale 404 for every missing path, whatever its prefix.
// Session and speaker URLs end in a Pretalx code, so outdated slugs go to the code's redirect page;
// other English URLs hand off to the English copy.
const localeHandoff =
	locale === defaultLocale
		? `const match = location.pathname.match(/^(\\/en)?\\/(sessions|speakers)\\/(?:[^/]*-)?([a-z0-9]{6})\\/?$/i);
			const code = match && \`\${match[1] ? '/en' : ''}/\${match[2].toLowerCase()}/\${match[3].toLowerCase()}/\`;
			if (code && location.pathname !== code) location.replace(code);
			else if (location.pathname.startsWith('/en/')) location.replace('${getLocalizedPath('en', '404')}');`
		: null;
---

<SiteLayout locale={locale} alternates={false} title={t.notFound.title} description={t.notFound.description}>
	{localeHandoff && <script is:inline set:html={localeHandoff} />}

	<main class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-3xl flex-col items-start justify-center gap-8 px-6 py-16 lg:px-8">
		<div class="space-y-4">
			<p class="text-sm font-semibold tracking-[0.24em] text-primary uppercase">404</p>
			<h1 class="font-heading text-5xl leading-none font-black tracking-[-0.05em] text-balance sm:text-6xl">
				{t.notFound.title}
			</h1>
			<p class="max-w-xl text-lg leading-8 text-muted-foreground">
				{t.notFound.description}
			</p>
		</div>

		<div class="flex flex-col gap-3 sm:flex-row">
			<Button asChild size="lg" className="rounded-full">
				<a href={getLocalizedPath(locale)}>{t.notFound.home}</a>
			</Button>
			<Button asChild variant="outline" size="lg" className="rounded-full">
				<a href={getLocalizedPath(alternateLocale)} hreflang={alternateLocale} data-locale={alternateLocale}>{t.notFound.alternate}</a>
			</Button>
		</div>
	</main>
</SiteLayout>
