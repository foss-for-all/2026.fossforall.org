---
import F4ALineArt from '../assets/f4a_line_art.svg';
import { DesktopNav } from './desktop-nav';
import { MobileNav } from './mobile-nav';
import { RegisterNavButton } from './register-nav-button';
import { ThemeToggle } from './theme-toggle';
import type { Locale } from '../i18n/config';
import type { NavigationItem } from '../i18n/navigation';
import { getLanguageOptions, getLocalizedPath } from '../i18n/utils';

interface Props {
	locale: Locale;
	path?: string;
	labels: {
		headerTitle: string;
		siteName: string;
		eventSummary: string;
		register: string;
		openNavigation: string;
		language: string;
		theme: string;
		lightTheme: string;
		darkTheme: string;
		systemTheme: string;
	};
	navItems: NavigationItem[];
}

const { locale, path = '', labels, navItems } = Astro.props;
const languageOptions = getLanguageOptions(locale, path);
const themeLabels = {
	theme: labels.theme,
	lightTheme: labels.lightTheme,
	darkTheme: labels.darkTheme,
	systemTheme: labels.systemTheme,
};
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-background/88 backdrop-blur supports-[backdrop-filter]:bg-background/72">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 lg:px-8">
		<a href={getLocalizedPath(locale)} aria-label={labels.headerTitle} class="flex shrink-0 items-center gap-3 text-sm font-black text-foreground">
			<F4ALineArt class="size-11 shrink-0" aria-hidden="true" />
			<span class="hidden sm:inline">{labels.headerTitle}</span>
		</a>

		<div class="hidden md:block">
			<DesktopNav client:load items={navItems} />
		</div>

		<div class="flex items-center gap-2 sm:gap-3">
			<ThemeToggle client:load labels={themeLabels} />
			<nav aria-label={labels.language} class="flex shrink-0 items-center text-sm font-medium whitespace-nowrap">
				{languageOptions.map((option, index) => (
					<>
						{index > 0 && <span aria-hidden="true" class="px-1.5 text-border">|</span>}
						<a
							href={option.href}
							hreflang={option.locale}
							lang={option.locale}
							data-locale={option.locale}
							aria-current={option.current ? 'page' : undefined}
							class={option.current ? 'text-foreground' : 'text-muted-foreground underline-offset-4 hover:text-foreground hover:underline'}
						>
							{option.label}
						</a>
					</>
				))}
			</nav>
			<div class="md:hidden">
				<MobileNav
					client:load
					items={navItems}
					title={labels.siteName}
					description={labels.eventSummary}
					registerLabel={labels.register}
					openLabel={labels.openNavigation}
				/>
			</div>
			<RegisterNavButton client:load label={labels.register} />
		</div>
	</div>
</header>
