---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { getSessions, sessionLabels } from '../data/sessions';
import type { Locale } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';
import SpeakerAvatar from './speaker-avatar.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = sessionLabels[locale];
const { groups } = await getSessions(locale);
const keynotes = groups.filter((group) => group.keynote).flatMap((group) => group.sessions);
const hasTranslations = keynotes.some((session) => Boolean(session.translation?.title?.text));
const otherLocale: Locale = locale === 'en' ? 'ko' : 'en';
---

{keynotes.length > 0 && (
	<section
		class="mx-auto max-w-7xl px-6 py-20 lg:px-8"
		aria-labelledby="keynotes-heading"
		data-translation-scope={hasTranslations ? '' : undefined}
		data-show-translated={hasTranslations ? 'true' : undefined}
	>
		<div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<h2 id="keynotes-heading" class="font-heading text-3xl leading-tight tracking-[-0.04em] sm:text-4xl">{labels.keynotes}</h2>
			<div class="flex flex-wrap items-center gap-4">
				{hasTranslations && (
					<button
						type="button"
						class={cn(buttonVariants({ variant: 'outline', size: 'xs' }))}
						data-translation-toggle
						aria-pressed="true"
					>
						<span class="tr-translated">{labels.showOriginal}</span>
						<span class="tr-original">{labels.translate}</span>
					</button>
				)}
				<a href={getLocalizedPath(locale, 'sessions')} class="w-fit font-medium text-primary underline underline-offset-4">{labels.allSessions}</a>
			</div>
		</div>
		<div class="grid gap-6 sm:grid-cols-2">
			{keynotes.flatMap((session) => {
				const translatedTitle = session.translation?.title?.text;
				const sourceLocale = session.translation?.title?.sourceLocale ?? otherLocale;
				return session.speakers.map((speaker) => (
					<a href={getLocalizedPath(locale, `sessions/${session.slug}`)} class="flex flex-col items-center gap-4 rounded-2xl border bg-card p-6 text-center shadow-sm transition-transform hover:-translate-y-1">
						<SpeakerAvatar speaker={speaker} size={128} />
						<span class="text-lg font-semibold break-keep">{speaker.name}</span>
						{translatedTitle ? (
							<span class="flex flex-col items-center gap-1 break-keep [overflow-wrap:anywhere]">
								<span class="tr-translated text-sm font-medium text-foreground/90" lang={locale}>{translatedTitle}</span>
								<span class="tr-orig-sub text-xs leading-snug text-muted-foreground" lang={sourceLocale}>{session.title}</span>
								<span class="tr-original text-sm text-muted-foreground" lang={sourceLocale}>{session.title}</span>
							</span>
						) : (
							<span class="text-sm text-muted-foreground break-keep">{session.title}</span>
						)}
					</a>
				));
			})}
		</div>
		{hasTranslations && (
			<p class="tr-translated mt-3 text-right text-xs text-muted-foreground">{labels.titlesTranslatedFootnote}</p>
		)}
	</section>
)}

{hasTranslations && (
	<script is:inline>
		(() => {
			const key = 'f4a-show-translated';
			const apply = (value) => {
				for (const scope of document.querySelectorAll('[data-translation-scope]')) {
					scope.setAttribute('data-show-translated', value);
					for (const toggle of scope.querySelectorAll('[data-translation-toggle]')) {
						toggle.setAttribute('aria-pressed', value);
					}
				}
			};
			const sync = () => {
				try {
					const saved = sessionStorage.getItem(key);
					if (saved === 'true' || saved === 'false') apply(saved);
				} catch {}
			};
			sync();
			if (!window.__f4aTrToggle) {
				window.__f4aTrToggle = true;
				window.addEventListener('pageshow', sync);
				document.addEventListener('click', (event) => {
					const button = event.target instanceof Element && event.target.closest('[data-translation-toggle]');
					if (!button) return;
					const scope = button.closest('[data-translation-scope]');
					if (!scope) return;
					const next = String(scope.getAttribute('data-show-translated') !== 'true');
					apply(next);
					try { sessionStorage.setItem(key, next); } catch {}
				});
			}
		})();
	</script>
)}

<style>
	[data-show-translated="true"] .tr-original { display: none; }
	[data-show-translated="false"] .tr-translated,
	[data-show-translated="false"] .tr-orig-sub { display: none; }
</style>
