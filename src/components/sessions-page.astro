---
import SiteLayout from '../layouts/site-layout.astro';
import type { Locale } from '../i18n/config';
import { sessionLabels } from '../data/sessions';
import Sessions from './sessions.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = sessionLabels[locale];
---

<SiteLayout locale={locale} path="sessions" title={labels.title} description={labels.description}>
	<main class="mx-auto max-w-4xl px-6 py-16 lg:px-8">
		<header class="mb-12 border-b pb-8">
			<h1 class="mt-3 font-heading text-4xl font-black tracking-[-0.04em] text-balance sm:text-5xl">{labels.title}</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">{labels.description}</p>
		</header>
		<Sessions locale={locale} />
	</main>
</SiteLayout>
