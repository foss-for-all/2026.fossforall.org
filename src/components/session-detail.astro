---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { renderMarkdown, summarize } from '../data/markdown';
import { extractLocaleSummary, sessionLabels, type Session } from '../data/sessions';
import type { Locale } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';
import SiteLayout from '../layouts/site-layout.astro';
import SpeakerAvatar from './speaker-avatar.astro';

interface Props { session: Session; locale: Locale }
const { session, locale } = Astro.props;
const labels = sessionLabels[locale];
const languages = new Intl.DisplayNames([locale], { type: 'language' });
const time = new Intl.DateTimeFormat(locale, { timeZone: 'Asia/Seoul', dateStyle: 'medium', timeStyle: 'short' });
const endTime = new Intl.DateTimeFormat(locale, { timeZone: 'Asia/Seoul', timeStyle: 'short' });
// One document, so footnote ids from the abstract and the description cannot collide.
const rawBody = [session.abstract, session.description].filter(Boolean).join('\n\n');
const body = await renderMarkdown(rawBody);
const otherLocale: Locale = locale === 'en' ? 'ko' : 'en';
const translatedTitle = session.translation?.title?.text;
const titleSourceLocale = session.translation?.title?.sourceLocale ?? otherLocale;
const translatedDescriptionText = session.translation?.description?.text;
const translatedBody = translatedDescriptionText ? await renderMarkdown(translatedDescriptionText) : undefined;
const descSourceLocale = session.translation?.description?.sourceLocale ?? otherLocale;
const hasTranslation = Boolean(translatedTitle || translatedBody);
const bilingualOnly = !hasTranslation && Boolean(session.translation?.title?.bilingual || session.translation?.description?.bilingual);
const defaultShowTranslated = locale === 'en';
const translatedNotice = translatedBody ? labels.translatedNotice : labels.translatedTitleNotice;
const previewTitle = defaultShowTranslated ? (translatedTitle ?? session.title) : session.title;
const previewBody = (defaultShowTranslated ? translatedDescriptionText : undefined)
	?? (session.translation?.description?.bilingual ? extractLocaleSummary(rawBody, locale) : rawBody);
const previewDescription = (await summarize(previewBody)) || session.speakers.map((speaker) => speaker.name).join(', ') || undefined;
const meta = [
	[labels.type, session.type],
	[labels.track, session.track],
	[labels.language, session.language && (languages.of(session.language) ?? session.language)],
	[labels.time, session.start && `${time.format(new Date(session.start))}${session.end ? ` - ${endTime.format(new Date(session.end))}` : ''}`],
	[labels.room, session.room],
].filter(([, value]) => value);
const links = [
	// Pretalx serves an .ics per talk once it has a slot in the released schedule.
	[labels.calendar, session.start && session.url && `${session.url.replace(/\/$/, '')}.ics`],
	[labels.video, session.video],
	[labels.feedback, session.feedback],
	[labels.pretalx, session.url],
].filter(([, href]) => href);
---

<SiteLayout locale={locale} path={`sessions/${session.slug}`} image={`/og/${locale}/sessions/${session.slug}.png`} title={previewTitle} description={previewDescription}>
	<main
		class="mx-auto max-w-4xl px-6 py-16 lg:px-8"
		data-translation-scope={hasTranslation ? '' : undefined}
		data-show-translated={hasTranslation ? String(defaultShowTranslated) : undefined}
	>
		<nav class="text-sm text-muted-foreground">
			<a href={getLocalizedPath(locale, 'sessions')} class="hover:text-foreground hover:underline">{labels.title}</a>
			<span aria-hidden="true" class="px-2">/</span>
			<span>{session.type}</span>
		</nav>
		<h1 class="mt-3 font-heading text-4xl font-black tracking-[-0.04em] text-balance break-keep [overflow-wrap:anywhere] sm:text-5xl">
			{translatedTitle ? (
				<>
					<span class="tr-translated" lang={locale}>{translatedTitle}</span>
					<span class="tr-original" lang={titleSourceLocale}>{session.title}</span>
				</>
			) : session.title}
		</h1>
		{translatedTitle && (
			<p class="tr-orig-sub mt-2 text-base leading-snug text-muted-foreground break-keep [overflow-wrap:anywhere] sm:text-lg" lang={titleSourceLocale}>
				{session.title}
			</p>
		)}

		{hasTranslation && (
			<div class="tr-bar mt-6 flex flex-wrap items-center justify-between gap-3 text-sm">
				<p class="tr-translated text-muted-foreground">{translatedNotice}</p>
				<button
					type="button"
					class={cn(buttonVariants({ variant: 'outline', size: 'xs' }))}
					data-translation-toggle
					aria-pressed={String(defaultShowTranslated)}
				>
					<span class="tr-translated">{labels.showOriginal}</span>
					<span class="tr-original">{labels.translate}</span>
				</button>
			</div>
		)}

		{bilingualOnly && (
			<div class="mt-6 flex flex-wrap items-center gap-3 text-sm" data-bilingual-scope data-show-note="false">
				<button
					type="button"
					class={cn(buttonVariants({ variant: 'outline', size: 'xs' }))}
					data-bilingual-toggle
					aria-expanded="false"
				>
					{labels.bilingualButton}
				</button>
				<p class="tr-bilingual-note text-muted-foreground" role="status">{labels.bilingualNotice}</p>
			</div>
		)}

		<dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-y py-6 text-sm">
			{meta.map(([term, value]) => (
				<>
					<dt class="font-semibold text-muted-foreground">{term}</dt>
					<dd>{value}</dd>
				</>
			))}
		</dl>

		{translatedBody ? (
			<>
				<article class="mdx-content tr-translated mt-10 max-w-none break-keep [overflow-wrap:anywhere]" lang={locale} set:html={translatedBody} />
				<article class="mdx-content tr-original mt-10 max-w-none break-keep [overflow-wrap:anywhere]" lang={descSourceLocale} set:html={body} />
			</>
		) : (
			<article class="mdx-content mt-10 max-w-none break-keep [overflow-wrap:anywhere]" set:html={body} />
		)}

		{session.speakers.length > 0 && (
			<section class="mt-12" aria-labelledby="speakers-heading">
				<h2 id="speakers-heading" class="font-heading text-2xl font-bold tracking-tight">{labels.speakers}</h2>
				<ul class="mt-4 grid gap-3 sm:grid-cols-2">
					{session.speakers.map((speaker) => (
						<li>
							<a href={getLocalizedPath(locale, `speakers/${speaker.slug}`)} class="flex items-center gap-4 rounded-xl border bg-card p-4 transition-colors hover:border-primary/60">
								<SpeakerAvatar speaker={speaker} size={56} />
								<span class="font-semibold">{speaker.name}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		{links.length > 0 && (
			<section class="mt-12" aria-labelledby="links-heading">
				<h2 id="links-heading" class="font-heading text-2xl font-bold tracking-tight">{labels.links}</h2>
				<div class="mt-4 flex flex-wrap gap-2">
					{links.map(([label, href]) => <a class={cn(buttonVariants({ variant: 'outline' }))} href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
				</div>
			</section>
		)}
	</main>
</SiteLayout>

{(hasTranslation || bilingualOnly) && (
	<script is:inline define:vars={{ locale }}>
		(() => {
			const key = `f4a-show-translated-${locale}`;
			const apply = (value) => {
				for (const scope of document.querySelectorAll('[data-translation-scope]')) {
					scope.setAttribute('data-show-translated', value);
					for (const toggle of scope.querySelectorAll('[data-translation-toggle]')) {
						toggle.setAttribute('aria-pressed', value);
					}
				}
			};
			const sync = () => {
				try {
					const saved = sessionStorage.getItem(key);
					if (saved === 'true' || saved === 'false') apply(saved);
				} catch {}
			};
			sync();
			if (!window.__f4aTrToggle) {
				window.__f4aTrToggle = true;
				window.addEventListener('pageshow', sync);
				document.addEventListener('click', (event) => {
					const target = event.target instanceof Element ? event.target : null;
					if (!target) return;
					const toggle = target.closest('[data-translation-toggle]');
					if (toggle) {
						const scope = toggle.closest('[data-translation-scope]');
						if (!scope) return;
						const next = String(scope.getAttribute('data-show-translated') !== 'true');
						apply(next);
						try { sessionStorage.setItem(key, next); } catch {}
						return;
					}
					const bilingual = target.closest('[data-bilingual-toggle]');
					if (bilingual) {
						const scope = bilingual.closest('[data-bilingual-scope]');
						if (!scope) return;
						const next = scope.getAttribute('data-show-note') !== 'true';
						scope.setAttribute('data-show-note', String(next));
						bilingual.setAttribute('aria-expanded', String(next));
					}
				});
			}
		})();
	</script>
)}

<style>
	[data-show-translated="true"] .tr-bar {
		padding: 0.625rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		background: color-mix(in oklch, var(--muted) 45%, transparent);
	}
	[data-show-translated="true"] .tr-original { display: none; }
	[data-show-translated="false"] .tr-translated,
	[data-show-translated="false"] .tr-orig-sub { display: none; }
	[data-show-note="false"] .tr-bilingual-note { display: none; }
</style>
