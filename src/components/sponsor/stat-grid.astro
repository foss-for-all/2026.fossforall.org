---
import type { Stat } from '../../data/sponsorship/types';

interface Props {
	stats: Stat[];
	cols?: string;
}

const { stats, cols = 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5' } = Astro.props;
---

<dl class={`grid gap-8 ${cols}`}>
	{
		stats.map((stat) => (
			<div class="text-center">
				<dd class="font-heading text-4xl font-semibold tracking-[-0.04em] tabular-nums sm:text-5xl">
					{stat.value}
				</dd>
				<dt class="mt-1 text-sm font-semibold text-muted-foreground break-keep">{stat.label}</dt>
			</div>
		))
	}
</dl>
