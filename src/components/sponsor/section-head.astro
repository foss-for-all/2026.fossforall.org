---
interface Props {
	num: string;
	title: string;
	lead?: string;
}

const { num, title, lead } = Astro.props;
---

<header class="mb-10">
	<div class="flex items-center gap-3">
		<span class="font-mono text-sm font-semibold text-primary">{num}</span>
		<span class="h-px flex-1 bg-border"></span>
	</div>
	<h2 class="mt-4 font-heading text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
		{title}
	</h2>
	{lead && <p class="mt-4 max-w-3xl leading-7 text-muted-foreground break-keep">{lead}</p>}
</header>
