---
import type { Logo } from '../../data/sponsorship/types';

interface Props {
	label: string;
	logos: Logo[];
	base: string;
	/** Optical scale in rem: the drawn height is k / sqrt(aspect ratio), as in the printed edition. */
	k?: number;
}

const { label, logos, base, k = 5 } = Astro.props;
const box = k + 1.5;
---

<div>
	<p class="kicker text-foreground">{label}</p>
	<div class="mt-1 h-px bg-foreground"></div>
	<ul class="mt-4 flex flex-wrap justify-center gap-3">
		{
			logos.map((logo) => (
				<li
					class="flex min-w-24 max-w-64 flex-1 basis-0 items-center justify-center rounded-sm bg-white px-4"
					style={`height:${box}rem`}
				>
					<img
						src={`${base}/${logo.file}`}
						alt={logo.name}
						loading="lazy"
						decoding="async"
						class="max-h-full max-w-full object-contain"
						style={`height:${((k / Math.sqrt(logo.ar)) * (logo.scale ?? 1)).toFixed(2)}rem`}
					/>
				</li>
			))
		}
	</ul>
</div>
