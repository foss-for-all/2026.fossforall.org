---
import type { Stop } from '../../data/sponsorship/types';

interface Props {
	stops: Stop[];
}

const { stops } = Astro.props;
---

<ol class="grid gap-6 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
	{
		stops.map((stop) => (
			<li>
				<p class={`font-mono text-xs font-semibold ${stop.done ? 'text-primary' : 'text-muted-foreground'}`}>
					{stop.when}
				</p>
				<div class="mt-2 flex items-center">
					<span
						class={`size-[7px] shrink-0 rounded-full border ${
							stop.done ? 'border-primary bg-primary' : 'border-border bg-background'
						}`}
					/>
					<span class="h-px flex-1 bg-border" />
				</div>
				<p class={`mt-2 text-sm break-keep ${stop.done ? 'font-semibold' : ''}`}>{stop.what}</p>
			</li>
		))
	}
</ol>
