---
import { pretalx } from '../config';
import type { Locale } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;

const labels = {
	ko: {
		pending: '일정표는 일정이 확정되면 공개됩니다. 그동안 세션 목록을 확인해 주세요.',
		links: '바로 가기',
		glance: '한눈에 보기 (A4)',
		subscribe: '캘린더 구독',
		google: 'Google 캘린더',
		sessions: '세션 목록 보기',
		noscript: '일정표를 보려면 JavaScript가 필요합니다. JavaScript 없이 보려면',
		here: '여기를 누르세요',
	},
	en: {
		pending: 'The schedule will be published once it is finalized. In the meantime, check out the session list.',
		links: 'Quick links',
		glance: 'At a glance (A4)',
		subscribe: 'Subscribe in calendar',
		google: 'Google Calendar',
		sessions: 'View sessions',
		noscript: 'JavaScript is disabled in your browser. To access our schedule without JavaScript,',
		here: 'click here',
	},
}[locale];

const timetablePath = getLocalizedPath(locale, 'timetable');
const sessionsPath = getLocalizedPath(locale, 'sessions');
const eventUrl = `${pretalx.baseUrl}/${pretalx.eventSlug}/`;
const ics = `${pretalx.exports}/schedule.ics`;
const webcal = ics.replace(/^https:/, 'webcal:');
const links = [
	[labels.glance, timetablePath],
	[labels.subscribe, webcal],
	[labels.google, `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`],
	['iCal', ics],
	['XML', `${pretalx.exports}/schedule.xml`],
	['xCal', `${pretalx.exports}/schedule.xcal`],
	['JSON', `${pretalx.exports}/schedule.json`],
	['RSS', pretalx.feed],
];
// The widget fails to load until a schedule version is released.
// Anything but 200 or 404 fails CI builds so a transient outage does not hide a released schedule.
const released = await fetch(`${eventUrl}schedule/widgets/schedule.json`, { method: 'HEAD', signal: AbortSignal.timeout(15000) })
	.then((response) => {
		if (response.ok || response.status === 404) return response.ok;
		throw new Error(`Pretalx schedule returned ${response.status}`);
	})
	.catch((error) => { if (process.env.CI) throw error; return false; });
---

{released && (
	<div class="mb-6 space-y-1.5 text-sm">
		<p class="!my-0">
			<strong>{labels.links}:</strong> {links.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}
		</p>
		{locale === 'en' && (
			<p class="!my-0 text-muted-foreground">
				For AI-translated titles, see the <a href={timetablePath}>printable timetable</a> or <a href={sessionsPath}>sessions list</a>.
			</p>
		)}
	</div>
)}

{released ? (
	<div class="overflow-hidden rounded-2xl border">
		<script is:inline src={`${eventUrl}widgets/schedule.js`}></script>
		<!-- The widget only has a light theme with hard-coded colours, and its dialog relies on UA defaults,
		     so keep it light and, in dark mode, add a copy of its rules with neutral colours flipped. -->
		<pretalx-schedule event-url={eventUrl} locale={locale} format="list" style="--pretalx-clr-primary: var(--primary); color-scheme: light"></pretalx-schedule>
		<script is:inline>
			customElements.whenDefined('pretalx-schedule').then(() => {
				const widget = document.querySelector('pretalx-schedule');
				const root = widget.shadowRoot;
				// Greys map onto the site's dark range (white becomes #171717); colours and images stay as they are.
				// Light text only ever sits on a coloured background here, so text is flipped only when dark.
				const flip = (value, text) => {
					const grey = (r, g, b, alpha = '') => Math.max(r, g, b) - Math.min(r, g, b) > 16 || (text && r > 127) ? null
						: `rgb${alpha ? 'a' : ''}(${Array(3).fill(Math.round(23 + (255 - r) * 0.82)).join(', ')}${alpha})`;
					return value
						.replace(/rgba?\((\d+), (\d+), (\d+)(, [\d.]+)?\)/g, (match, r, g, b, alpha) => grey(+r, +g, +b, alpha) ?? match)
						.replace(/#([0-9a-f]{6}|[0-9a-f]{3})\b/gi, (match, hex) => {
							const [r, g, b] = (hex.length === 3 ? [...hex].map((c) => c + c) : hex.match(/../g)).map((c) => parseInt(c, 16));
							return grey(r, g, b) ?? match;
						});
				};
				const ours = document.createElement('style');
				const walk = (list, rules) => {
					for (const rule of list) {
						if (rule.cssRules && !rule.selectorText) walk(rule.cssRules, rules);
						if (!rule.selectorText) continue;
						const decls = [...rule.style].filter((name) => name.startsWith('--') || /color|background|border|shadow|fill|stroke/.test(name))
							.map((name) => [name, rule.style.getPropertyValue(name), /^(color|fill|--pretalx-clr-text)$/.test(name)])
							.filter(([, value, text]) => flip(value, text) !== value)
							.map(([name, value, text]) => `${name}: ${flip(value, text)}`);
						if (decls.length) rules.push(`${rule.selectorText.split(',').map((part) => `:host([data-dark]) ${part}`).join(',')} { ${decls.join('; ')} }`);
					}
				};
				const parseColor = (value) => {
					const rgb = value.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
					if (rgb) return [+rgb[1], +rgb[2], +rgb[3]];
					const hex = value.trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)?.[1];
					if (!hex) return null;
					return (hex.length === 3 ? [...hex].map((c) => c + c) : hex.match(/../g)).map((c) => parseInt(c, 16));
				};
				const luminance = ([r, g, b]) => [r, g, b].reduce((sum, c, i) => {
					const s = c / 255;
					return sum + (s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4) * [0.2126, 0.7152, 0.0722][i];
				}, 0);
				// Mark bright track colours so text on them uses dark ink and labels on white stay legible.
				const tagTracks = () => {
					for (const el of root.querySelectorAll('[style*="--track-color"], [style*="--pill-color"]')) {
						const raw = el.style.getPropertyValue('--track-color') || el.style.getPropertyValue('--pill-color');
						const rgb = parseColor(raw);
						if (rgb) el.toggleAttribute('data-light-track', luminance(rgb) > 0.2);
					}
				};
				const trackContrastRules = [
					'.c-linear-schedule-session .time-box .duration, .break .time-box .duration { color: rgba(255, 255, 255, 0.88); }',
					'.c-linear-schedule-session[data-light-track] .time-box .start, .break[data-light-track] .time-box .start { color: #171717; }',
					'.c-linear-schedule-session[data-light-track] .time-box .duration, .break[data-light-track] .time-box .duration { color: #171717; }',
					':host(:not([data-dark])) .c-linear-schedule-session[data-light-track] .info .bottom-info .track, :host(:not([data-dark])) .break[data-light-track] .info .bottom-info .track { color: color-mix(in srgb, var(--track-color) 42%, #000000); }',
					':host(:not([data-dark])) .pretalx-schedule .filter-pill[data-light-track].has-color:not(.active) { color: color-mix(in srgb, var(--pill-color) 42%, #000000); border-color: color-mix(in srgb, var(--pill-color) 65%, #000000); }',
					':host([data-dark]) .c-linear-schedule-session .info .bottom-info .track, :host([data-dark]) .break .info .bottom-info .track { color: color-mix(in srgb, var(--track-color) 50%, #ffffff); }',
					':host([data-dark]) .c-linear-schedule-session:hover .info, :host([data-dark]) .break:hover .info { border-color: color-mix(in srgb, var(--track-color) 55%, #ffffff); }',
					':host([data-dark]) .pretalx-schedule .filter-pill.has-color:not(.active) { color: color-mix(in srgb, var(--pill-color) 50%, #ffffff); border-color: color-mix(in srgb, var(--pill-color) 55%, #ffffff); }',
					':host([data-dark]) .pretalx-schedule .filter-pill.active, :host([data-dark]) .pretalx-schedule .filter-pill.active:hover, :host([data-dark]) .pretalx-schedule .filter-pill.has-color:not(.active):hover { background-color: var(--pill-color, var(--pretalx-clr-primary)); border-color: var(--pill-color, var(--pretalx-clr-primary)); color: #ffffff; }',
					'.pretalx-schedule .filter-pill[data-light-track].active, .pretalx-schedule .filter-pill[data-light-track].active:hover, .pretalx-schedule .filter-pill[data-light-track].has-color:not(.active):hover, :host([data-dark]) .pretalx-schedule .filter-pill[data-light-track].active, :host([data-dark]) .pretalx-schedule .filter-pill[data-light-track].active:hover, :host([data-dark]) .pretalx-schedule .filter-pill[data-light-track].has-color:not(.active):hover { color: #171717; }',
				];
				// The widget adds its stylesheets while it renders, so rebuild whenever one arrives.
				const build = () => {
					const rules = [':host([data-dark]) .pretalx-modal { background-color: #171717; color: #ededed; }'];
					for (const sheet of root.styleSheets) if (sheet.ownerNode !== ours) walk(sheet.cssRules, rules);
					rules.push(...trackContrastRules);
					ours.textContent = rules.join('\n');
					root.append(ours);
				};
				build();
				tagTracks();
				new MutationObserver((mutations) => {
					if (mutations.some((mutation) => [...mutation.addedNodes].some((node) => node.nodeName === 'STYLE' && node !== ours))) build();
					tagTracks();
				}).observe(root, { childList: true, subtree: true, attributes: true, attributeFilter: ['style'] });
				const sync = () => widget.toggleAttribute('data-dark', document.documentElement.classList.contains('dark'));
				sync();
				new MutationObserver(sync).observe(document.documentElement, { attributeFilter: ['class'] });
			});
		</script>
		<noscript>
			<p class="p-6">{labels.noscript} <a href={`${eventUrl}schedule/`} target="_blank" rel="noopener noreferrer">{labels.here}</a>.</p>
		</noscript>
	</div>
) : (
	<div class="rounded-2xl border border-dashed bg-muted/40 px-6 py-10 text-center">
		<p class="text-muted-foreground">{labels.pending}</p>
		<a href={getLocalizedPath(locale, 'sessions')}>{labels.sessions}</a>
	</div>
)}
