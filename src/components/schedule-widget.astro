---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { pretalx } from '../config';
import type { Locale } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;

const labels = {
	ko: {
		pending: '일정표는 일정이 확정되면 공개됩니다. 그동안 세션 목록을 확인해 주세요.',
		get: '일정 받아보기',
		glance: '한눈에 보기 (A4 인쇄용)',
		subscribe: '캘린더 구독',
		subscribeHelp: '구독하면 일정이 바뀔 때 캘린더에도 자동으로 반영됩니다.',
		google: 'Google 캘린더',
		download: '.ics 내려받기',
		apps: '일정 앱',
		appsHelp: '아래 XML 주소를 앱에 추가하세요.',
		data: '원본 데이터',
		feed: '일정 변경 RSS',
		sessions: '세션 목록 보기',
		noscript: '일정표를 보려면 JavaScript가 필요합니다. JavaScript 없이 보려면',
		here: '여기를 누르세요',
	},
	en: {
		pending: 'The schedule will be published once it is finalized. In the meantime, check out the session list.',
		get: 'Get the schedule',
		glance: 'At a glance (printable A4)',
		subscribe: 'Subscribe in your calendar',
		subscribeHelp: 'A subscription picks up schedule changes automatically.',
		google: 'Google Calendar',
		download: 'Download .ics',
		apps: 'Schedule apps',
		appsHelp: 'Add the XML address below to the app.',
		data: 'Raw schedule data',
		feed: 'Schedule updates (RSS)',
		sessions: 'View sessions',
		noscript: 'JavaScript is disabled in your browser. To access our schedule without JavaScript,',
		here: 'click here',
	},
}[locale];

const eventUrl = `${pretalx.baseUrl}/${pretalx.eventSlug}/`;
const ics = `${pretalx.exports}/schedule.ics`;
const webcal = ics.replace(/^https:/, 'webcal:');
// Apps that take any Frab/Pentabarf XML URL, as listed on FOSDEM's mobile apps page.
const apps = [
	['Giggity (Android)', 'https://f-droid.org/packages/net.gaast.giggity/'],
	['ConfClerk (Linux)', 'https://www.toastfreeware.priv.at/confclerk'],
	['Confy (GTK)', 'https://confy.kirgroup.net'],
];
const data = [['XML', `${pretalx.exports}/schedule.xml`], ['iCal', ics], ['xCal', `${pretalx.exports}/schedule.xcal`], ['JSON', `${pretalx.exports}/schedule.json`]];
// The widget fails to load until a schedule version is released.
// Anything but 200 or 404 fails CI builds so a transient outage does not hide a released schedule.
const released = await fetch(`${eventUrl}schedule/widgets/schedule.json`, { method: 'HEAD', signal: AbortSignal.timeout(15000) })
	.then((response) => {
		if (response.ok || response.status === 404) return response.ok;
		throw new Error(`Pretalx schedule returned ${response.status}`);
	})
	.catch((error) => { if (process.env.CI) throw error; return false; });
---

{released && (
	<section class="mb-8 rounded-2xl border bg-card p-6 text-card-foreground" aria-labelledby="get-schedule">
		<h2 id="get-schedule" class="!mt-0 !border-0 !pb-0 font-heading text-xl font-bold">{labels.get}</h2>
		<div class="mt-4 flex flex-wrap gap-2">
			<a class={cn(buttonVariants(), 'no-underline')} href={webcal}>{labels.subscribe}</a>
			<a class={cn(buttonVariants({ variant: 'outline' }), 'text-foreground no-underline')} href={`https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`} target="_blank" rel="noopener noreferrer">{labels.google}</a>
			<a class={cn(buttonVariants({ variant: 'outline' }), 'text-foreground no-underline')} href={ics}>{labels.download}</a>
			<a class={cn(buttonVariants({ variant: 'outline' }), 'text-foreground no-underline')} href={getLocalizedPath(locale, 'timetable')}>{labels.glance}</a>
		</div>
		<p class="mt-2 text-sm text-muted-foreground">{labels.subscribeHelp}</p>
		<dl class="mt-5 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
			<dt class="font-semibold">{labels.apps}</dt>
			<dd>{apps.map(([name, href], i) => <>{i > 0 && ' · '}<a href={href} target="_blank" rel="noopener noreferrer">{name}</a></>)} <span class="text-muted-foreground">{labels.appsHelp}</span></dd>
			<dt class="font-semibold">{labels.data}</dt>
			<dd>{data.map(([name, href], i) => <>{i > 0 && ' · '}<a href={href}>{name}</a></>)}</dd>
			<dt class="font-semibold">RSS</dt>
			<dd><a href={pretalx.feed} type="application/atom+xml">{labels.feed}</a></dd>
		</dl>
	</section>
)}

{released ? (
	<div class="overflow-hidden rounded-2xl border">
		<script is:inline src={`${eventUrl}widgets/schedule.js`}></script>
		<!-- The widget only has a light theme with hard-coded colours, and its dialog relies on UA defaults,
		     so keep it light and, in dark mode, add a copy of its rules with neutral colours flipped. -->
		<pretalx-schedule event-url={eventUrl} locale={locale} format="list" style="--pretalx-clr-primary: var(--primary); color-scheme: light"></pretalx-schedule>
		<script is:inline>
			customElements.whenDefined('pretalx-schedule').then(() => {
				const widget = document.querySelector('pretalx-schedule');
				const root = widget.shadowRoot;
				// Greys map onto the site's dark range (white becomes #171717); colours and images stay as they are.
				// Light text only ever sits on a coloured background here, so text is flipped only when dark.
				const flip = (value, text) => {
					const grey = (r, g, b, alpha = '') => Math.max(r, g, b) - Math.min(r, g, b) > 16 || (text && r > 127) ? null
						: `rgb${alpha ? 'a' : ''}(${Array(3).fill(Math.round(23 + (255 - r) * 0.82)).join(', ')}${alpha})`;
					return value
						.replace(/rgba?\((\d+), (\d+), (\d+)(, [\d.]+)?\)/g, (match, r, g, b, alpha) => grey(+r, +g, +b, alpha) ?? match)
						.replace(/#([0-9a-f]{6}|[0-9a-f]{3})\b/gi, (match, hex) => {
							const [r, g, b] = (hex.length === 3 ? [...hex].map((c) => c + c) : hex.match(/../g)).map((c) => parseInt(c, 16));
							return grey(r, g, b) ?? match;
						});
				};
				const ours = document.createElement('style');
				const walk = (list, rules) => {
					for (const rule of list) {
						if (rule.cssRules && !rule.selectorText) walk(rule.cssRules, rules);
						if (!rule.selectorText) continue;
						const decls = [...rule.style].filter((name) => name.startsWith('--') || /color|background|border|shadow|fill|stroke/.test(name))
							.map((name) => [name, rule.style.getPropertyValue(name), /^(color|fill|--pretalx-clr-text)$/.test(name)])
							.filter(([, value, text]) => flip(value, text) !== value)
							.map(([name, value, text]) => `${name}: ${flip(value, text)}`);
						if (decls.length) rules.push(`${rule.selectorText.split(',').map((part) => `:host([data-dark]) ${part}`).join(',')} { ${decls.join('; ')} }`);
					}
				};
				// The widget adds its stylesheets while it renders, so rebuild whenever one arrives.
				const build = () => {
					const rules = [':host([data-dark]) .pretalx-modal { background-color: #171717; color: #ededed; }'];
					for (const sheet of root.styleSheets) if (sheet.ownerNode !== ours) walk(sheet.cssRules, rules);
					ours.textContent = rules.join('\n');
					root.append(ours);
				};
				build();
				new MutationObserver((mutations) => {
					if (mutations.some((mutation) => [...mutation.addedNodes].some((node) => node.nodeName === 'STYLE' && node !== ours))) build();
				}).observe(root, { childList: true });
				const sync = () => widget.toggleAttribute('data-dark', document.documentElement.classList.contains('dark'));
				sync();
				new MutationObserver(sync).observe(document.documentElement, { attributeFilter: ['class'] });
			});
		</script>
		<noscript>
			<p class="p-6">{labels.noscript} <a href={`${eventUrl}schedule/`} target="_blank" rel="noopener noreferrer">{labels.here}</a>.</p>
		</noscript>
	</div>
) : (
	<div class="rounded-2xl border border-dashed bg-muted/40 px-6 py-10 text-center">
		<p class="text-muted-foreground">{labels.pending}</p>
		<a href={getLocalizedPath(locale, 'sessions')}>{labels.sessions}</a>
	</div>
)}
