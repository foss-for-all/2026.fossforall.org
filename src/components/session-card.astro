---
import { Badge } from '@/components/ui/badge';
import { sessionLabels, type Session } from '../data/sessions';
import type { Locale } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';
import SpeakerAvatar from './speaker-avatar.astro';

interface Props { session: Session; locale: Locale }
const { session, locale } = Astro.props;
const labels = sessionLabels[locale];
const languages = new Intl.DisplayNames([locale], { type: 'language' });
const translatedTitle = session.translation?.title?.text;
const sourceLocale = session.translation?.title?.sourceLocale ?? (locale === 'en' ? 'ko' : 'en');
---

<a href={getLocalizedPath(locale, `sessions/${session.slug}`)} class="flex flex-col gap-4 rounded-xl border bg-card p-6 text-card-foreground shadow-sm transition-colors hover:border-primary/60">
	<div>
		<h3 class="text-xl leading-snug font-semibold tracking-tight break-keep [overflow-wrap:anywhere]">
			{translatedTitle ? (
				<>
					<span class="tr-translated" lang={locale}>{translatedTitle}</span>
					<span class="tr-original" lang={sourceLocale}>{session.title}</span>
				</>
			) : session.title}
		</h3>
		{translatedTitle && (
			<span class="tr-orig-sub mt-1 block text-xs leading-snug font-normal text-muted-foreground break-keep [overflow-wrap:anywhere]" lang={sourceLocale}>
				{session.title}
			</span>
		)}
	</div>
	<ul class="flex flex-col gap-2 text-sm text-muted-foreground">
		{session.speakers.length > 0 ? session.speakers.map((speaker) => (
			<li class="flex items-center gap-2"><SpeakerAvatar speaker={speaker} size={24} />{speaker.name}</li>
		)) : <li>{labels.unknownSpeaker}</li>}
	</ul>
	<div class="flex flex-wrap gap-2">
		{session.track && <Badge variant="secondary" className="h-auto max-w-full text-left whitespace-normal">{session.track}</Badge>}
		{session.language && <Badge variant="outline">{languages.of(session.language) ?? session.language}</Badge>}
	</div>
</a>

<style>
	:global([data-show-translated="true"]) .tr-original { display: none; }
	:global([data-show-translated="false"]) .tr-translated,
	:global([data-show-translated="false"]) .tr-orig-sub { display: none; }
</style>
