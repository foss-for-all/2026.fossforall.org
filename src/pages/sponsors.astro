---
import SponsorSection from '../components/sponsor-section.astro';
import { getSponsors } from '../data/sponsors';
import SiteLayout from '../layouts/site-layout.astro';

const content = getSponsors('ko');
---

<SiteLayout locale="ko" path="sponsors" title={content.title} description={content.description}>
	<main>
		<SponsorSection locale="ko" showIntro />
	</main>
</SiteLayout>
