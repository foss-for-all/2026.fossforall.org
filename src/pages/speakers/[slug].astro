---
import SpeakerDetail from '../../components/speaker-detail.astro';
import { getSpeakers } from '../../data/sessions';
import { getLocalizedPath } from '../../i18n/utils';

export async function getStaticPaths() {
	return (await getSpeakers('ko')).flatMap((speaker) => [
		{ params: { slug: speaker.slug }, props: { speaker, redirect: false } },
		// The bare code is a short link that survives name changes.
		...(speaker.slug === speaker.code.toLowerCase() ? [] : [{ params: { slug: speaker.code.toLowerCase() }, props: { speaker, redirect: true } }]),
	]);
}

const { speaker, redirect } = Astro.props;
if (redirect) return Astro.redirect(getLocalizedPath('ko', `speakers/${speaker.slug}`));
---

<SpeakerDetail locale="ko" speaker={speaker} />
