---
import SpeakerDetail from '../../../components/speaker-detail.astro';
import { getSpeakers } from '../../../data/sessions';

export async function getStaticPaths() {
	return (await getSpeakers('en')).map((speaker) => ({ params: { code: speaker.code }, props: { speaker } }));
}

const { speaker } = Astro.props;
---

<SpeakerDetail locale="en" speaker={speaker} />
